# PyroScope configuration. Copy to .env (git-ignored) or export in the shell.
# Never commit real secrets.

# --- database (default: SQLite file data/pyroscope.db) ---
# DATABASE_URL=postgresql+psycopg://pyroscope:CHANGE_ME@localhost:5432/pyroscope
# Supabase transaction pooler (NullPool, no prepared statements are used automatically for port 6543):
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# PYROSCOPE_DB_POOL=auto              # auto | transaction | session | direct
# PYROSCOPE_DB_POOL_SIZE=5            # direct / session connections only
# PYROSCOPE_EMBEDDED_WORKER=1         # 1 = API process also runs jobs (dev); 0 with a separate `python -m app.worker`

# --- object storage (default: local data/object_store) ---
# PYROSCOPE_STORAGE=local             # local | supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=          # backend only; never in the frontend or VITE_* variables

# --- Vercel frontend origins (production CORS) ---
# PYROSCOPE_CORS_ORIGIN_REGEX=^https://pyroscope-[a-z0-9-]+-<team>\.vercel\.app$   # preview deployments (anchored, no .*)

# --- independent validation sources (optional) ---
# OPENAQ_API_KEY=
# DATA_GOV_IN_API_KEY=

# --- authentication ---
PYROSCOPE_AUTH_MODE=dev              # dev | production (production ignores the X-User header)
# PYROSCOPE_ADMIN_PASSWORD=          # sets the 'admin' login once, if it has no password yet
PYROSCOPE_SESSION_HOURS=12
# PYROSCOPE_PBKDF2_ITERATIONS=          # password-hash work factor (default in security.py)
PYROSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- NASA data access ---
# FIRMS_MAP_KEY=                     # free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# PYRA_LFS_MEDIA_BASE=https://media.githubusercontent.com/media/HIFIGUY1234/Pyra/main

# --- notifications (default: simulated, nothing leaves the app) ---
PYROSCOPE_NOTIFY_PROVIDER=simulated  # simulated | webhook | smtp
# PYROSCOPE_WEBHOOK_ALLOWED_HOSTS=hooks.example.gov.in
# PYROSCOPE_WEBHOOK_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_TLS_MODE=starttls             # starttls | ssl | none (none only for a local relay); overrides SMTP_STARTTLS
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# PYROSCOPE_NOTIFY_MAX_ATTEMPTS=3     # retries apply to transient failures only
# PYROSCOPE_NOTIFY_RETRY_BASE_S=2
# PYROSCOPE_NOTIFY_TIMEOUT_S=15
# PYROSCOPE_WEBHOOK_ALLOW_PRIVATE=0   # 1 disables the public-IP (SSRF) check: local testing only, never in production

# --- VIIRS 750 m granules + MCD64A1 / VNP64A1 burned area (LAADS / LP DAAC, Earthdata Login) ---
# EARTHDATA_TOKEN=                   # or a ~/.netrc entry for urs.earthdata.nasa.gov; never commit it
#                                    # the Earthdata account must ALSO accept the LAADS licence and authorise LP DAAC

# --- rate limiting (in-process; nginx adds its own limits) ---
# PYROSCOPE_RATE_LIMIT=on             # off only for tests
# PYROSCOPE_TRUST_PROXY=0             # 1 only behind a reverse proxy (compose sets it); uses X-Forwarded-For
# PYROSCOPE_RL_LOGIN=10               # per minute; UPLOAD / PROCESSING / REPORT / ADMIN are per 10 minutes

# --- output locations ---
# PYROSCOPE_REPORTS_DIR=data/reports
# PYROSCOPE_AUDIT_RETENTION_DAYS=      # audit-log retention; empty keeps everything
