# PyroScope configuration. Copy to .env (git-ignored) or export in the shell.
# Never commit real secrets.

# --- database (default: SQLite file data/pyroscope.db) ---
# DATABASE_URL=postgresql+psycopg://pyroscope:CHANGE_ME@localhost:5432/pyroscope

# --- authentication ---
PYROSCOPE_AUTH_MODE=dev              # dev | production (production ignores the X-User header)
# PYROSCOPE_ADMIN_PASSWORD=          # sets the 'admin' login once, if it has no password yet
PYROSCOPE_SESSION_HOURS=12
# PYROSCOPE_PBKDF2_ITERATIONS=          # password-hash work factor (default in security.py)
PYROSCOPE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- NASA data access ---
# FIRMS_MAP_KEY=                     # free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# PYRA_LFS_MEDIA_BASE=https://media.githubusercontent.com/media/HIFIGUY1234/Pyra/main

# --- notifications (default: simulated, nothing leaves the app) ---
PYROSCOPE_NOTIFY_PROVIDER=simulated  # simulated | webhook | smtp
# PYROSCOPE_WEBHOOK_ALLOWED_HOSTS=hooks.example.gov.in
# PYROSCOPE_WEBHOOK_TOKEN=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- output locations ---
# PYROSCOPE_REPORTS_DIR=data/reports
