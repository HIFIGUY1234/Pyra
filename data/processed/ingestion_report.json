 "viirs_750m": {
  "status": "not_in_firms",
  "products": {
   "Suomi NPP": "VNP14 (VIIRS/NPP Thermal Anomalies/Fire 6-Min L2 Swath 750 m)",
   "NOAA-20": "VJ114 (VIIRS/JPSS1 Thermal Anomalies/Fire 6-Min L2 Swath 750 m)"
  },
  "facts": [
   "The 750 m product applies the MODIS Collection 6 fire algorithm to VIIRS M-bands and is NASA's continuity product for the MODIS 1 km record.",
   "FIRMS distributes only the 375 m VIIRS product as CSV; 750 m data are Level-2 NetCDF swath granules from LAADS DAAC / LP DAAC (Earthdata Login required)."
  ],
  "how_to_add": "Download VNP14 granules for the AOI from LAADS DAAC, run `python -m app.acquire vnp14 <granule dir> --satellite 'Suomi NPP'` to convert the fire-pixel tables to a FIRMS-like CSV in data/raw/, then rerun the pipeline. It is ingested as product_type=750m and calibrated separately from 375 m."
 },
